\" in MN Statue 169.011 are allowed on the trail. Motorized bicycles and other electric cycles (e.g. e-motos) are not allowed on the trail.","weatherPolicy":"Please monitor trail conditions before heading out. We recommend waiting at least 12-24 hours (in some cases more) after a rainfall. When riding if you are sinking in and leaving tire ruts or foot print impressions, we ask that you do not ride and hop off the trail. Thank you!","notes":null,"amenities":["trail-map","picnic-area","skills-area","trail-signage","free-parking","bike-repair-station","drinking-water","restrooms","tire-pump"],"waiverUrl":null,"url":"https://www.woodburymn.gov/447/Carver-Lake-Off-Road-Cycling-Trail","socials":{"Facebook":"mtbcarverlake","Trailforks":"https://www.trailforks.com/region/carver-lake-park/","MTB Project":"https://www.mtbproject.com/trail/3520161/carver-lake-park"},"maps":{"Trails (PDF)":"https://www.woodburymn.gov/DocumentCenter/View/425/Carver-Lake-Park-Off-Road-Cycling-Trail-Map-PDF?bidId="},"agency":"City of Woodbury, MN","statusTags":[],"organizationId":"OUrkWOo2IydWZaG1Hy81","organization":{"name":"Minnesota Off-Road Cyclists","shortName":"MORC","url":"https://www.morcmtb.org/","logoUrl":"https://storage.googleapis.com/trailbot-covers-prod/6b99e26e-c135-4de4-adc9-54eda2e46476.jpg","slug":"morc","flags":["volunteers","donations","memberships"],"embedKey":"36dc2fd4-babb-4355-bd81-0722b7c84838","timezone":"America/Chicago"},"street":"3175 Century Ave S","embedKey":"d37f7ac5-d6c1-4df7-a45b-66bae89b616e","latestUpdateId":"PQetKPVKmnY5BFaojUqsL","defaults":{"hideOsmTrails":false},"fields":{},"customFields":{},"last24Precip":0.1,"last24PrecipType":"rain","regions":["Twin Cities Metro"]},{"trailId":"KiChiSagaParkSingletrack","trailName":"Ki-Chi-Saga Park Singletrack","description":"","trailStatus":"Open","city":"Lindstrom","state":"MN","country":"US","lat":45.367035,"long":-92.82455,"zipcode":"55045","timezone":"America/Chicago","pictures":[],"active":true,"visibility":"public