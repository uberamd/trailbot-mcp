{"trails":[{"trailId":"d932e5fc-a4a4-4e33-820d-864556d0c0ec","trailName":"Elm Creek","description":"","trailStatus":"Closed","city":"Champlin","state":"MN","country":"US","lat":45.1807175,"long":-93.4167322,"zipcode":"55316","timezone":"America/Chicago","pictures":[],"active":true,"visibility":"public","updatedAt":1790512770781,"slug":"elm-creek","logoUrl":"https://storage.googleapis.com/trailbot-covers-prod/a638f69f-4d67-4157-9391-3cc88c0a6dc0.jpg","coverUrl":null,"joinUrl":"https://www.morcmtb.org/store","donationUrl":"https://www.morcmtb.org/store","ticketUrl":null,"volunteerUrl":"https://www.morcmtb.org/elm-creek","sourceDescription":"Updates are provided directly by trail maintainers.","ebikePolicy":null,"weatherPolicy":null,"notes":"Open 5am-10pm. Grab your mountain bike and explore 12.7 miles of sustainable trail. Located in the northeast corner of Elm Creek Park Reserve, the singletrack trail is the largest trail of its kind in the northern metro. Built to accommodate all skill levels of riders, the track features 2.2 miles of trail with a difficulty rating of \"easy,\" 8.1 miles of trail rated \"more difficult,\" and 2.4 miles of trail rated \"most difficult.\"","amenities":[],"waiverUrl":null,"url":"https://www.threeriversparks.org/location/elm-creek-singletrack-trail","socials":{"Instagram":"elmcreekparkreserve","Trailforks":"https://www.trailforks.com/region/elm-creek-park/","MTB Project":"https://www.mtbproject.com/directory/8015292/elm-creek-park-reserve","Facebook":"ElmCreekSingletrack"},"maps":{"Winter (PDF)":"https://threeriversparks.link/ElmCreek_ParkReserve_Winter","Singletrack (PDF)":"https://threeriversparks.link/ElmCreek_ParkReserve_SingletrackTrail","Interactive":"https://www.threeriversparks.org/location/elm-creek-singletrack-trail","Summer (PDF)":"https://threeriversparks.link/ElmCreek_ParkReserve_Summer","Winter (Avenza)":"https://www.avenzamaps.com/maps/1208840/elm-creek-park-reserve-winter","Summer (Avenza)":"https://www.avenzamaps.com/maps/1208880/elm-creek-park-reserve-summer","Singletrack (Avenza)":"https://www.avenzamaps.com/maps/1208827/elm-creek-park-reserve-singletrack-trail"},"agency":"Three Rivers Park District","statusTags":[],"organizationId":"OUrkWOo2IydWZaG1Hy81","organization":{"name":"Minnesota Off-Road Cyclists","shortName":"MORC","url":"https://www.morcmtb.org/","logoUrl":"https://storage.googleapis.com/trailbot-covers-prod/6b99e26e-c135-4de4-adc9-54eda2e46476.jpg","slug":"morc","flags":["volunteers","donations","memberships"],"embedKey":"36dc2fd4-babb-4355-bd81-0722b7c84838","timezone":"America/Chicago"},"street":"1827 W Hayden Lake Rd","embedKey":"d960483e-6bd9-404a-8c79-4e148f893c62","latestUpdateId":"VFZDq9VHDUO8OqCQe0YDd","defaults":{"hideOsmTrails":false},"fields":{},"customFields":{},"last24Precip":0.1,"last24PrecipType":"rain","regions":["Twin Cities Metro"]},{"trailId":"ec5949d8-b11a-4b1c-a659-22fbf7577b64","trailName":"Hillside Park","description":"Looks like rain will be continuing through the rest of the daylight hours. We will be closed for the rest of the day. Probably be able to open tomorrow. \n\nTrail Work Monday 5 to 7. We will be starting work on the new jump line now that we have some moisture in the dirt.","trailStatus":"Closed","city":"Elk River","state":"MN","country":"US","lat":45.299075,"long":-93.539913,"zipcode":"55330","timezone":"America/Chicago","pictures":[],"active":true,"visibility":"public","updatedAt":1790447092870,"slug":"hillside-park","logoUrl":null,"coverUrl":null,"joinUrl":"https://www.morcmtb.org/store","donationUrl":"https://www.morcmtb.org/store","ticketUrl":null,"volunteerUrl":"https://www.morcmtb.org/hillside-park","sourceDescription":"Updates are provided directly by trail maintainers.","ebikePolicy":null,"weatherPolicy":"Please do not ride the trail when it is wet/muddy.  If you are leaving marks in the trail or your tires are picking up a lot of dirt, it is too wet to ride.  Trail generally needs 12-24 hours to dry after a rain event (depending on rainfall amount and time of year).  There is a gate at the entrance to the trail that indicates when the trail is closed.","notes":null,"amenities":[],"waiverUrl":null,"url":"https://www.elkrivermn.gov/Facilities/Facility/Details/Hillside-City-Park-27","socials":{"Facebook":"HillsideParkSingletrack","Trailforks":"https://www.trailforks.com/region/hillside-city-park/","MTB Project":"https://www.mtbproject.com/trail/3680808/hillside"},"maps":{"Trails (PDF)":"https://www.elkrivermn.gov/DocumentCenter/View/9126/Hillside-Mountain-Bike-Map"},"agency":"City of Elk River, MN","statusTags":[],"organizationId":"OUrkWOo2IydWZaG1Hy81","organization":{"name":"Minnesota Off-Road Cyclists","shortName":"MORC","url":"https://www.morcmtb.org/","logoUrl":"https://storage.googleapis.com/trailbot-covers-prod/6b99e26e-c135-4de4-adc9-54eda2e46476.jpg","slug":"morc","flags":["volunteers","donations","memberships"],"embedKey":"36dc2fd4-babb-4355-bd81-0722b7c84838","timezone":"America/Chicago"},"street":"10801 181st Ave NW","embedKey":"7fa4ab6e-276f-4053-9df3-4864517eaaa9","latestUpdateId":"CgEcWyWqR0WYUzSRnVVNv","defaults":{"hideOsmTrails":false},"fields":{},"customFields":{},"last24Precip":0.1,"last24PrecipType":"rain","regions":["Twin Cities Metro"]},{"trailId":"BraemarTrails","trailName":"Braemar Trails","description":"","trailStatus":"Closed","city":"Edina","state":"MN","country":"US","lat":44.86880179810791,"long":-93.3803976730164,"zipcode":"55439","timezone":"America/Chicago","pictures":[],"active":true,"visibility":"public","updatedAt":1790445817422,"slug":"braemar-trails","logoUrl":null,"coverUrl":null,"joinUrl":null,"donationUrl":null,"ticketUrl":null,"volunteerUrl":null,"sourceDescription":"Updates are provided directly by trail maintainers.","ebikePolicy":null,"weatherPolicy":null,"notes":"Parking only at designated trailhead locations. Multiple segments of trail system linked by paved shared use trail.","amenities":[],"waiverUrl":null,"url":"https://www.edinamn.gov